PORT=3000
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
NODE_ENV=development

FIREBASE_PROJECT_ID=nihongo-class-dev
FIREBASE_STORAGE_BUCKET=nihongo-class-dev.firebasestorage.app
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json   # not needed with the emulators
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080                  # remove the three emulator lines for a real project
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

STORAGE_PROVIDER=firebase    # firebase | supabase (files only; sign-in and the database stay on Firebase)
SUPABASE_URL=                # https://<project-ref>.supabase.co (only for STORAGE_PROVIDER=supabase)
SUPABASE_SECRET_KEY=         # the project's secret key (sb_secret_...) or legacy service_role key; never put it in the web app
SUPABASE_BUCKET=nihongo-files          # private: materials and My Drive (created automatically)
SUPABASE_PUBLIC_BUCKET=nihongo-audio   # public: built-in library audio (created automatically)

DEFAULT_TIME_ZONE=Asia/Manila
FILE_TICKET_SECRET=          # 32+ random bytes, base64
TOKEN_ENCRYPTION_KEY=        # exactly 32 bytes, base64 (AES-256-GCM for Google refresh tokens)
JOB_SECRET=                  # random string, sent as X-Job-Secret

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

PAYMONGO_MODE=mock           # mock | test | live
PAYMONGO_SECRET_KEY=         # sk_test_... or sk_live_... (not needed in mock mode)
PAYMONGO_WEBHOOK_SECRET=     # the webhook's secret key; any random string in mock mode
PAYMONGO_PAYMENT_METHODS=gcash,paymaya,qrph,card
TURN_URLS=                   # optional, for in-app video calls: turn:turn.example.com:3478
TURN_USERNAME=
TURN_CREDENTIAL=
MATERIAL_MAX_FILE_MB=25
